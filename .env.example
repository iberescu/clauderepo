# docker compose up reads this file automatically for ${VAR} substitutions in
# docker-compose.yml. Copy to `.env` (same directory as docker-compose.yml)
# and fill in real values to run against live Google + Gemini APIs.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up --build
#
# Leave FAKE_PROVIDERS=true (or delete this file) to keep the fully-offline
# deterministic flow.

FAKE_PROVIDERS=false
GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
GEMINI_API_KEY=
